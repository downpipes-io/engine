{
  "$schema": "https://schema.management.azure.com/schemas/2019-04-01/deploymentParameters.json#",
  "contentVersion": "1.0.0.0",
  "parameters": {
    "workspaceName": {
      "value": "my-sentinel-workspace"
    },
    "apiHost": {
      "value": "engine.customer.example"
    },
    "bearerToken": {
      "reference": {
        "keyVault": {
          "id": "/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.KeyVault/vaults/<vault-name>"
        },
        "secretName": "downpipes-audit-feed-bearer-token"
      }
    }
  }
}
