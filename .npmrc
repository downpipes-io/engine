# Required: madge@8 -> @typescript-eslint/project-service pins typescript ">=4.8.4 <6.1.0" while
# madge's own peerOptional is "^5.4.4", and our pinned typescript (7.x) trips an ERESOLVE without
# this. Track removal when madge's transitive typescript peer range widens. Without this, npm install
# fails on the madge devDep peer conflict. madge gets the 6.x API through scripts/madge-ts6-resolve.mjs.
legacy-peer-deps=true

# Dependency install scripts are off. Nothing in this tree needs one to build, lint or test.
ignore-scripts=true
