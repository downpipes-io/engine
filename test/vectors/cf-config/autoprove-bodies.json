  "device-ip-profiles": {
    "body": {
      "description": "dp-roundtrip",
      "match": "identity.email == \"dp@example.com\"",
      "name": "dp-roundtrip-ipp",
      "precedence": 100
    },
    "path": "/accounts/{}/devices/ip-profiles",
    "why": "subnet_id is resolved at RUN TIME from the account's own zerotrust subnets. It used to be a literal, which meant this surface could only prove on the one account that subnet belonged to and refused everywhere else with 'subnet_id must be valid uuid', a refusal that reads like a defect. An account-specific identifier in a shared vector is not a body, it is a note about one machine.",
    "resolve": {
      "subnet_id": {
        "path": "/accounts/{}/zerotrust/subnets",
        "field": "id"
      }
    }
  },
