  "dlp-email-rules": {
    "body": {
      "name": "dp-roundtrip-emailrule",
      "enabled": false,
      "action": {
        "action": "Block"
      },
      "conditions": [
        {
          "operator": "InList",
          "selector": "Recipients",
          "value": "dp-roundtrip"
        }
      ]
    },
    "path": "/accounts/{}/dlp/email/rules",
    "why": "`action` is an internally tagged enum: {\"action\": \"Block\"}, not the bare string the synthesised body carried. Cloudflare named the type in its refusal (expected internally tagged enum EmailRuleAction) but not the tag, so the shape was found by trying the plausible tags. Unlike its DLP siblings this surface is NOT Forbidden on a paid account, so the old body was recording OUR malformed request as the reason when the surface was creatable all along."
  },
