{
  "about": "The customer deploy preflight (scripts/deploy.sh) runs validate:customer:chain, the members of validate:chain marked keep here. Every other member keeps running in npm run validate and in CI on every push; each is named here with the category whose one-line reason says why a customer deploy leaves it out. test/validate-customer-preflight.ts fails when validate:chain and this file disagree.",
  "commonReason": "Every left-out member grades code that CI graded on the same commit. On a customer machine the preflight establishes that this tree is that commit's code with its locked dependencies (lint:deps-installed), that it typechecks and that it builds, and it re-runs the gates for the customer's data and keys.",
  "keepReason": "Guards the customer's data or keys: the archive bytes (crypto, format, seal, read, restore, destination write and delete, WORM, anti-rollback), the keys (generation, install, rotation, the configuration wrap key, the signed update channel) or code this deploy runs on the customer's machine (deploy.sh, generate-keys.ts, sync-bindings.mjs, stamp-build-id.mjs).",
  "dropReasons": {
    "cross-repo": "Reads a sibling checkout (console, docs or the downpipe reader) or refuses when one is behind its own origin/main; a customer checkout sits on a release tag with no docs or reader beside it, so here it can only refuse or skip.",
    "dev-process": "Grades how this repository is developed (gate wiring, guard and mutation harnesses, coverage drivers, CI, vendor release tooling), not the engine this deploy uploads.",
    "docs-parity": "Grades that a document in this repository agrees with the code it cites; it protects a reader of the document, not the engine this deploy uploads.",
    "identity": "Grades sign-in, sessions, roles and identity providers inside the running Worker: who may act, not the archive bytes or keys.",
    "integrations": "Grades outbound reporting (notifications, email, SIEM, OTLP, metrics, ITSM) and its simulators, not the archive bytes or keys.",
    "outbound-safety": "Grades the running Worker's outbound request guards (egress screening, TLS floor, redirects, credential scope), not the archive bytes or keys.",
    "support": "Grades what the product reports about itself (support-pack evidence, diagnostics, fault classification, the honesty of the numbers it shows), not the archive bytes or keys.",
    "timing": "Depends on elapsed time under load: it failed a timing assertion (15 against 16) after 54 minutes on a machine at load average 50, and a customer machine can be that busy.",
    "worker-behaviour": "Grades a Worker feature (scheduling, sources, admin routes, configuration, reports, updates) that does not write, read or delete archive bytes or keys."
  },
  "measured": {
    "seconds": 738,
    "text": "It took 299 to 738 seconds (5 to 12 minutes) when measured, at load averages from 15 to 110."
  },
